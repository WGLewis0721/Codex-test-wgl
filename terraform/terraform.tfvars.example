###############################################################################
# terraform.tfvars.example
#
# Copy this file to terraform.tfvars and fill in real values before running
# `terraform plan` or `terraform apply`.
#
# IMPORTANT: terraform.tfvars is listed in .gitignore and must NEVER be
# committed to source control because it may contain sensitive values such
# as your admin_cidr or key_name.
###############################################################################

# ---------------------------------------------------------------------------
# General
# ---------------------------------------------------------------------------
aws_region   = "us-east-1"
project_name = "itsm-agent"
environment  = "dev"   # dev | staging | prod

# ---------------------------------------------------------------------------
# Networking
# ---------------------------------------------------------------------------
vpc_cidr             = "10.0.0.0/16"
public_subnet_cidrs  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnet_cidrs = ["10.0.101.0/24", "10.0.102.0/24"]
availability_zones   = ["us-east-1a", "us-east-1b"]

# Restrict SSH to your corporate/VPN egress IP – never leave as 0.0.0.0/0 in prod
admin_cidr = "203.0.113.10/32"

# ---------------------------------------------------------------------------
# Compute
# ---------------------------------------------------------------------------
instance_type     = "t3.large"       # CPU-only workloads
gpu_instance_type = "g4dn.xlarge"    # GPU workloads (use_gpu = true)
use_gpu           = false

# Name of an existing EC2 Key Pair in your AWS account
key_name = "my-ec2-key"

root_volume_size_gb = 50
data_volume_size_gb = 100

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
ollama_model   = "llama3"
openwebui_port = 8080
fastapi_port   = 8000

# ---------------------------------------------------------------------------
# S3
# ---------------------------------------------------------------------------
# Leave empty to auto-generate: itsm-agent-docs-<account_id>
s3_bucket_name = ""

s3_lifecycle_ia_days      = 90
s3_lifecycle_glacier_days = 365
s3_lifecycle_expiry_days  = 730

# ---------------------------------------------------------------------------
# CloudWatch
# ---------------------------------------------------------------------------
log_retention_days      = 90
cpu_alarm_threshold     = 80
memory_alarm_threshold  = 85
disk_alarm_threshold    = 85

# Optional: ARN of an existing SNS topic for alarm notifications
# alarm_sns_arn = "arn:aws:sns:us-east-1:123456789012:my-alerts-topic"
alarm_sns_arn = ""
